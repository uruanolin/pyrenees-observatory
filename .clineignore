# =============================================================================
# AI Agent Context Exclusions (.geminiignore / .clineignore)
# Excludes heavy dependencies, cache, binary artefacts, and noise.
# =============================================================================

# Dependencies & Package Managers
node_modules/
*/node_modules/
frontend/node_modules/
.venv/
*/.venv/
backend/.venv/
venv/
env/

# Python Cache, Bytecode & Tooling
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage/

# Build Outputs & Bundles
dist/
build/
*/dist/
*/build/
.next/
.nuxt/
*.tsbuildinfo

# Version Control & IDE Noise
.git/
.svn/
.idea/
.vscode/
*.swp
*.swo

# Local Databases & Heavy Uploads
*.sqlite3
*.db
uploads/
*/uploads/
pgdata/

# OS Noise & Debug Logs
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
